# Android
package_name(ENV["ANDROID_PACKAGE_NAME"] || "com.novansa.twka")

# Note: json_key_file is set via SUPPLY_JSON_KEY environment variable in
# android-credentials.env. fastlane supply uses ENV["SUPPLY_JSON_KEY"].
