# iOS deployment credentials — Twikka
# Copy this file to ios-credentials.env and fill in your values.
# DO NOT commit ios-credentials.env (it's gitignored).

# Apple ID (your Apple Developer account email)
export APPLE_ID="your-apple-id@example.com"

# Novansa Pty Ltd team ID
export TEAM_ID="4R5HLHSR7V"

# App bundle ID (overrides the Appfile default if set)
export IOS_BUNDLE_ID="com.novansa.twka"

# App Store Connect API Key (preferred)
# App Store Connect → Users and Access → Keys (Integrations) → create key
# with "App Manager" role. Download the .p8 (only available once!) and note
# the Key ID + Issuer ID.
export APP_STORE_CONNECT_KEY_ID="XXXXXXXXXX"
export APP_STORE_CONNECT_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export APP_STORE_CONNECT_KEY_PATH="$PROJECT_ROOT/ci-cd/secrets/AuthKey_XXXXXXXXXX.p8"

# Optional: TestFlight "What to Test" notes for this build.
export IOS_WHATSNEW="Internal build for testing"
