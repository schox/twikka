# Android deployment credentials — Twikka
# Copy this file to android-credentials.env and fill in your values.
# DO NOT commit android-credentials.env (it's gitignored).

# Google Play service account JSON.
# Google Play Console → Setup → API access → create service account →
# grant "Release to testing tracks" → download JSON.
export SUPPLY_JSON_KEY="$PROJECT_ROOT/ci-cd/secrets/google-play-service.json"

# Android package name. Must match android/app/build.gradle.kts applicationId.
export ANDROID_PACKAGE_NAME="com.novansa.twka"

# Google Play track. Use 'internal' for the internal-testing track on first
# upload; switch to 'beta' or 'production' once the app is reviewed.
export ANDROID_TRACK="internal"

# Release notes for Google Play (English).
export ANDROID_RELEASE_NOTES_EN="Internal build for testing"

# Optional: keystore credentials, if not stored in android/key.properties.
# export KEYSTORE_PASSWORD="your-keystore-password"
# export KEY_PASSWORD="your-key-password"
