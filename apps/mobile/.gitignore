# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Secrets — never commit
.env
.env.*
!.env.example
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node / Convex
node_modules/

# CI/CD — secrets, build artefacts, and per-deploy logs
ci-cd/secrets/*.env
!ci-cd/secrets/*.env.example
ci-cd/secrets/*.p8
ci-cd/secrets/*.p12
ci-cd/secrets/*.json
ci-cd/secrets/*.jks
ci-cd/secrets/*.mobileprovision
ci-cd/secrets/certificates/
ci-cd/secrets/profiles/
ci-cd/build_number.txt
ci-cd/logs/

# Fastlane scratch
ci-cd/fastlane/report.xml
ci-cd/fastlane/Preview.html
ci-cd/fastlane/screenshots/
ci-cd/fastlane/test_output/

# Bundler
/.bundle/
/vendor/bundle/
