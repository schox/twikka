{
  "name": "@novansa/providers",
  "version": "0.1.0",
  "description": "Shared React providers and contexts for Novansa Apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novansa/database": "*",
    "@novansa/ui": "*",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.62.10",
    "@tanstack/react-query-devtools": "^5.62.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@novansa/config": "*",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.13",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers/*": {
      "import": "./dist/providers/*.mjs",
      "require": "./dist/providers/*.js",
      "types": "./dist/providers/*.d.ts"
    },
    "./contexts/*": {
      "import": "./dist/contexts/*.mjs",
      "require": "./dist/contexts/*.js", 
      "types": "./dist/contexts/*.d.ts"
    }
  }
}