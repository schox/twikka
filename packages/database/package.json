{
  "name": "@novansa/database",
  "version": "0.1.0",
  "description": "Shared database types and utilities for Novansa Apps monorepo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "type-check": "tsc --noEmit",
    "types:generate": "npx supabase gen types typescript --project-id cpgapeppncrhrfoubqvh --schema public > src/database.types.ts"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "database",
    "types",
    "supabase",
    "postgresql",
    "monorepo"
  ]
}
