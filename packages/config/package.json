{
  "name": "@novansa/config",
  "version": "0.1.0",
  "description": "Shared configuration for ESLint, Prettier, and TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "eslint",
    "prettier",
    "typescript"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}' 'eslint/**/*.{js,mjs}' 'prettier/**/*.js'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}' 'eslint/**/*.{js,mjs}' 'prettier/**/*.js'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint-config-next": "15.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslint": "./eslint/index.mjs",
    "./eslint/package": "./eslint/package.mjs",
    "./prettier": "./prettier/index.js",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/package.json": "./typescript/package.json"
  }
}