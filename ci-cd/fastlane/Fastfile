# Fastlane configuration for Twikka
# https://docs.fastlane.tools/

default_platform(:ios)

def env!(key, fallback = nil)
  value = ENV[key]
  return value unless value.nil? || value.empty?
  return fallback unless fallback.nil?
  UI.user_error!("Missing required environment variable: #{key}")
end

def project_root
  File.expand_path("../..", __dir__)
end

# Load CONVEX_URL / CLERK_PUBLISHABLE_KEY etc. into the dart-define-from-file
# path. The .env.local at the repo root is the same file `flutter run` reads
# in dev — keep them aligned.
def dart_define_from_file
  File.join(project_root, ".env.local")
end

platform :ios do
  desc "Build and deploy iOS app to TestFlight"
  lane :beta do
    build_number = ENV['BUILD_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')
    version_name = ENV['VERSION_NAME'] || '1.0.0'

    UI.message("Building iOS #{version_name} (#{build_number})")

    sh("cd #{project_root} && flutter clean")
    sh("cd #{project_root} && flutter pub get")

    cocoapods(
      podfile: "#{project_root}/ios/Podfile",
      try_repo_update_on_error: true
    )

    # Generate ExportOptions.plist with App Store Connect API key inline so
    # xcodebuild can authenticate for automatic signing without a local
    # Apple ID session.
    require 'tempfile'
    export_options_content = <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{env!('TEAM_ID', '4R5HLHSR7V')}</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>uploadSymbols</key>
        <true/>
        <key>compileBitcode</key>
        <false/>
        <key>authenticationKeyID</key>
        <string>#{env!('APP_STORE_CONNECT_KEY_ID')}</string>
        <key>authenticationKeyIssuerID</key>
        <string>#{env!('APP_STORE_CONNECT_ISSUER_ID')}</string>
        <key>authenticationKeyPath</key>
        <string>#{env!('APP_STORE_CONNECT_KEY_PATH')}</string>
      </dict>
      </plist>
    XML
    export_options_plist = File.join(Dir.tmpdir, 'TwikkaExportOptions.plist')
    File.write(export_options_plist, export_options_content)

    sh("cd #{project_root} && flutter build ipa --release --no-tree-shake-icons --build-name=#{version_name} --build-number=#{build_number} --dart-define-from-file='#{dart_define_from_file}' --export-options-plist='#{export_options_plist}'")

    ipa_path = Dir["#{project_root}/build/ios/ipa/*.ipa"].first
    UI.user_error!("IPA not found at #{project_root}/build/ios/ipa/") unless ipa_path

    UI.success("IPA built: #{File.basename(ipa_path)}")

    release_notes = ENV['IOS_WHATSNEW'] || "Build #{build_number}\n• Bug fixes and improvements"

    api_key = app_store_connect_api_key(
      key_id: env!('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: env!('APP_STORE_CONNECT_ISSUER_ID'),
      key_filepath: env!('APP_STORE_CONNECT_KEY_PATH'),
      duration: 1200,
      in_house: false
    )

    pilot(
      ipa: ipa_path,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: release_notes,
      api_key: api_key,
      app_identifier: env!('IOS_BUNDLE_ID', 'com.novansa.twka')
    )

    UI.success("iOS #{version_name} (#{build_number}) uploaded to TestFlight!")
  end

  desc "Build iOS app for local testing (no upload)"
  lane :build do
    build_number = ENV['BUILD_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')
    version_name = ENV['VERSION_NAME'] || '1.0.0'

    UI.message("Building iOS #{version_name} (#{build_number}) [LOCAL]")

    sh("cd #{project_root} && flutter clean")
    sh("cd #{project_root} && flutter pub get")
    sh("cd #{project_root} && flutter build ipa --release --no-tree-shake-icons --build-name=#{version_name} --build-number=#{build_number} --dart-define-from-file='#{dart_define_from_file}'")

    ipa_path = Dir["#{project_root}/build/ios/ipa/*.ipa"].first
    UI.success("IPA built: #{ipa_path}")
  end
end

platform :android do
  desc "Build and deploy Android app to Google Play Internal Testing"
  lane :beta do
    build_number = ENV['BUILD_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')
    version_name = ENV['VERSION_NAME'] || '1.0.0'

    UI.message("Building Android #{version_name} (#{build_number})")

    sh("cd #{project_root} && flutter clean")
    sh("cd #{project_root} && flutter pub get")
    sh("cd #{project_root} && flutter build appbundle --release --no-tree-shake-icons --build-name=#{version_name} --build-number=#{build_number} --dart-define-from-file='#{dart_define_from_file}'")

    aab_path = "#{project_root}/build/app/outputs/bundle/release/app-release.aab"
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)

    UI.success("AAB built: #{File.basename(aab_path)}")

    release_notes = ENV['ANDROID_RELEASE_NOTES_EN'] || "Build #{build_number}\n• Bug fixes and improvements"
    track = ENV['ANDROID_TRACK'] || 'internal'

    supply(
      aab: aab_path,
      track: track,
      release_status: 'draft', # 'draft' until first production release; switch to 'completed' after.
      json_key: env!('SUPPLY_JSON_KEY'),
      package_name: env!('ANDROID_PACKAGE_NAME', 'com.novansa.twka'),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      version_code: build_number.to_i,
      version_name: version_name
    )

    UI.success("Android #{version_name} (#{build_number}) uploaded to #{track} track!")
  end

  desc "Build Android app for local testing (no upload)"
  lane :build do
    build_number = ENV['BUILD_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')
    version_name = ENV['VERSION_NAME'] || '1.0.0'

    UI.message("Building Android #{version_name} (#{build_number}) [LOCAL]")

    sh("cd #{project_root} && flutter clean")
    sh("cd #{project_root} && flutter pub get")
    sh("cd #{project_root} && flutter build appbundle --release --no-tree-shake-icons --build-name=#{version_name} --build-number=#{build_number} --dart-define-from-file='#{dart_define_from_file}'")

    aab_path = "#{project_root}/build/app/outputs/bundle/release/app-release.aab"
    UI.success("AAB built: #{aab_path}")
  end
end
