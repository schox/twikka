# Convex — copy to .env.local (gitignored) and fill in with your own values.
# Ingested by flutter via `--dart-define-from-file=.env.local`
# and by `npx convex dev` directly.

# Convex dev deployment
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Clerk — publishable key is bundled into the Flutter build; secret key
# only ever lives on the Convex deployment (set via `npx convex env set`).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
CLERK_WEBHOOK_SIGNING_SECRET=
